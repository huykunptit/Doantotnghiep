# ── Public domain / Cloudflare Tunnel ────────────────────────────────────────
# Domain đã trỏ trên Cloudflare: eript-lms.io.vn
PUBLIC_URL=https://eript-lms.io.vn

# Token lấy từ Cloudflare Zero Trust → Networks → Tunnels → Create → Docker
# (hoặc Configure → copy token). KHÔNG commit token thật lên git.
CLOUDFLARE_TUNNEL_TOKEN=

# AI keys (optional — cũng có thể đặt trong backend/.env)
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
