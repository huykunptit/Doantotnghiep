[Unit]
Description=LMS deploy agent (pull/build via /update-lms)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Doantotnghiep
EnvironmentFile=-/opt/Doantotnghiep/.env.deploy
Environment=DEPLOY_AGENT_HOST=127.0.0.1
Environment=DEPLOY_AGENT_PORT=9099
# Bắt buộc trong .env.deploy:
#   DEPLOY_SECRET=doi-thanh-chuoi-dai-ngau-nhien
ExecStart=/usr/bin/python3 /opt/Doantotnghiep/scripts/deploy-agent.py
Restart=on-failure
RestartSec=3

# Agent chỉ cần git + docker trên host
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
